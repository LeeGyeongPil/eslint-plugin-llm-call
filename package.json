{
  "name": "eslint-plugin-llm-call",
  "version": "0.2.0",
  "description": "ESLint plugin that catches model- and SDK-version-specific parameter mistakes in OpenAI and Anthropic SDK calls before they return HTTP 400.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "openai",
    "anthropic",
    "llm",
    "lint"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "eslint-plugin-llm-call": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-data.mjs",
    "test": "vitest run",
    "verify": "npm run build && npm test && npm run demo",
    "ci:repro": "node scripts/ci-repro.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@types/node": "22.20.5",
    "@typescript-eslint/parser": "8.72.2",
    "eslint": "10.15.0",
    "openai": "7.57.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.8"
  }
}
